# Security headers applied to every response by Cloudflare Pages.
# Conservative set (no strict CSP yet) so nothing in the SPA / auth / payment
# flows breaks; CSP can be layered on later after testing.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=*, camera=*, display-capture=*, autoplay=*, payment=(self)
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0

# Caching. Vite fingerprints everything under /assets (file name changes when
# content changes), so browsers may keep those for a year. Static images get a
# week. The service worker must always be re-checked so app updates arrive.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/logo.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/icons.svg
  Cache-Control: public, max-age=604800
/pwa-192.png
  Cache-Control: public, max-age=604800
/pwa-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/sw.js
  Cache-Control: no-cache